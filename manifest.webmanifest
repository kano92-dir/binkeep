{
  "name": "binkeep",
  "short_name": "binkeep",
  "description": "Binary analysis in your browser: PE, ELF, Mach-O, .NET and Android. The file never leaves your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [
          ".exe",
          ".dll",
          ".sys",
          ".so",
          ".dylib",
          ".elf",
          ".bin",
          ".o",
          ".dex"
        ],
        "application/vnd.android.package-archive": [
          ".apk"
        ],
        "application/zip": [
          ".zip"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "file",
          "accept": [
            "*/*",
            ".exe",
            ".dll",
            ".so",
            ".dylib",
            ".apk",
            ".dex",
            ".zip",
            ".bin",
            ".elf"
          ]
        }
      ]
    }
  }
}
